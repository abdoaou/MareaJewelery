# Required in Dokploy → Environment (replace with your values)
NODE_ENV=production
PORT=3000
API_VERSION=v1

DATABASE_URL=postgresql://user:pass@host:5432/postgres

JWT_SECRET=change-me-min-32-chars
JWT_REFRESH_SECRET=change-me-different-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
FRONTEND_URL=https://yourdomain.com
ADMIN_URL=https://yourdomain.com/admin

BREVO_API_KEY=xkeysib-your-key
EMAIL_FROM=Marea Jewelry <info@marea.com>
EMAIL_REPLY_TO=info@marea.com

RATE_LIMIT_MAX=300

# Optional — Cloudflare R2 product images
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=marea-images
R2_PUBLIC_URL=

# Optional — Redis (leave unset if not using)
# REDIS_URL=redis://localhost:6379
# REDIS_ENABLED=false
