# API Environment Variables

NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# JWT
JWT_SECRET=your-long-random-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-different-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5175

# Email — use Brevo HTTP API on Railway (SMTP ports are blocked there)
# Brevo → SMTP & API → API Keys tab → generate key (starts with xkeysib-)
BREVO_API_KEY=
# Use a verified domain email (info@marea.com), NOT @gmail.com — Gmail blocks Brevo sends from Gmail addresses
EMAIL_FROM=Marea Jewelry <info@marea.com>
EMAIL_REPLY_TO=prvtabdo70@gmail.com

# Optional local fallback (works on your computer, not on Railway)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# URLs
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5175

# Rate limiting
RATE_LIMIT_MAX=300

# Cloudflare R2 (product images). Leave empty to store files in api/uploads locally.
# Dashboard → R2 → Manage R2 API Tokens → Create API token
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=marea-images
# Public bucket URL (R2.dev or custom domain), no trailing slash
# e.g. https://pub-xxxxx.r2.dev  or  https://images.yourdomain.com
R2_PUBLIC_URL=

